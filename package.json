{
  "name": "dsh-edu",
  "version": "0.1.0",
  "private": true,
  "description": "DSH plugin: show GPT/Grok limits and DeepSeek/Zhipu balances in the composer dock.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
